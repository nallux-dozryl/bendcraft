  "proposal": {
    "actual_clip_phase": "Before position application/support/minor/fall/restitution in Java. Proposed read-only candidate evaluation computes LM first, so no global read/callback-order parity is claimed.",
    "api": "travel_checked(MH.State,L.Tables,Request)->MH.State & L.Tables & Result<&2,&2,Error,Outcome>",
    "call_order": [
      "T.prepare_checked",
      "LM.move_checked exactly once",
      "derive resolved metadata/required predicate from M.Transition and old saved H/feet",
      "required FR.clip_checked or explicit NotRequired without FR",
      "H.movement fixed NeutralDryNoDamage exactly once",
      "T.finish_checked",
      "atomic commit"
    ],
    "module_path_not_created": "src/fall_reset_travel.bend",
    "no_caller_authoritative_body_history_endpoints_clip": true,
    "not_required_policy": "Canonical tails still checked; ray profile/interior/work unused and no FR call.",
    "persistent_authority": "Existing MH.State alone owns W/SP/minor/H; Tables remain external.",
    "ray_policy": "Explicit FR profile, whole-visited-cell interior and two-reads-per-cell work; independent of LCW query-AABB border admission and edge fuel.",
    "rollback_anchor": "One pre-preparation Frame.View/SP/minor/H; retain the returned Engine/Core/Registry/Tables, restore original immutable data on every failure.",
    "unsupported": "Hits/damage/fluid/flight/effects/history-sensitive restitution/observable callbacks and full travel/tick remain outside projection."
  },
